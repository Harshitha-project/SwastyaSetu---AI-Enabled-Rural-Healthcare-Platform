{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/server.ts",
    "src/config/**/*",
    "src/middleware/**/*",
    "src/routes/index.ts",
    "src/routes/auth.routes.ts",
    "src/controllers/auth.controller.ts",
    "src/services/**/*",
    "src/utils/**/*",
    "src/types/**/*",
    "src/scripts/seed.ts"
  ],
  "exclude": ["node_modules", "dist", "src/models/**/*", "src/controllers/!(auth)*"]
}
